# Environment Variables Example for MOVA Frontend

# API backend endpoint (for PyTorch WebSocket inference server)
VITE_API_URL=http://localhost:8000

# Form Service Endpoint (e.g., Formspree https://formspree.io/f/YOUR_FORM_ID or Web3Forms https://api.web3forms.com/submit)
# All user inquiries, reports, and questions anywhere on the site are delivered to hashircoet@gmail.com through this endpoint.
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Optional access key if required by your form service provider (e.g. for Web3Forms)
VITE_FORM_ACCESS_KEY=
